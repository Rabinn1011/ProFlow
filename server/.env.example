# Copy to server/.env and fill in. Never commit the real .env.

# --- Server ---
PORT=5000

# "production" also switches the refresh cookie to SameSite=None; Secure, which is
# required when the client is served from a different domain than this API.
NODE_ENV=development

# Comma-separated list of allowed browser origins. Used for both HTTP CORS and the
# Socket.io handshake. Must include the Vite dev server URL locally, and the deployed
# client URL in production (e.g. https://proflow.vercel.app) — no trailing slash.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local: mongodb://127.0.0.1:27017/proflow
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/proflow?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/proflow

# Set to "true" to boot the API without connecting to MongoDB (health checks only).
SKIP_DB=false

# --- Auth ---
# Two DIFFERENT random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Token lifetimes in seconds. Defaults: 15 minutes / 7 days.
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
