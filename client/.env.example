# Copy to client/.env.local for local overrides. Never commit real values.

# Base URL of the ProFlow API, including the /api prefix.
# NOTE: Vite inlines this at BUILD time — it is baked into the bundle, not read at
# runtime. Production builds must be built with the production value set.
#
# Local:      http://localhost:5000/api
# Production: https://your-api-host.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api
